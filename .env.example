# Local dev: SQLite file. Production: Neon / Vercel Postgres URL.
# Example: postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=sqlite:///elderly_care.db

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-me

# Shared secret for Vercel Cron endpoints (Stage 3+)
CRON_SECRET=replace-me

# Email (Stage 6+). Leave blank locally to print emails to console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ElderCare <no-reply@example.com>
SMTP_USE_TLS=true

APP_TIMEZONE=Asia/Kolkata
AUTO_CREATE_TABLES=1